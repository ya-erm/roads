# Агент доски задач (npm run agent, docs/TASK_AGENT.md). Скопируйте в .env и заполните.

# Сервис досок, slug доски из её адреса и API-токен доски с правом write.
TASKS_BASE_URL=https://tasks.example.com
TASKS_BOARD=my-board
TASKS_TOKEN=

# Имя исполнителя в истории карточек и в комментариях.
# TASK_AGENT_ACTOR=Claude Code

# Как часто смотреть доску, секунд.
# TASK_AGENT_POLL_SECONDS=60

# Сколько задач держать в работе одновременно (все — в одном рабочем дереве).
# TASK_AGENT_PARALLEL=1

# Claude Code: модель и усилие (low, medium, high, xhigh, max), режим разрешений
# (auto — Claude сам решает, что безопасно; acceptEdits, bypassPermissions — см. claude --help),
# лимит расходов и времени на одну задачу, дополнительные аргументы claude через пробел.
# TASK_AGENT_MODEL=claude-opus-5-5
# TASK_AGENT_EFFORT=high
# TASK_AGENT_PERMISSION_MODE=auto
# TASK_AGENT_MAX_BUDGET_USD=10
# TASK_AGENT_TIMEOUT_MINUTES=120
# TASK_AGENT_CLAUDE_ARGS=
# TASK_AGENT_CLAUDE_BIN=claude

# Модель для названий задач, у которых его нет.
# TASK_AGENT_TITLE_MODEL=haiku

# Коммитить результат каждой задачи отдельным коммитом (без push). По умолчанию изменения остаются в рабочем дереве.
# TASK_AGENT_COMMIT=false

# На доработке продолжать прежнюю сессию Claude по этой задаче.
# TASK_AGENT_RESUME=true

# Сколько раз пробовать задачу, если Claude падает, и пауза между попытками; потом — отчёт об ошибке и «Нужно проверить».
# TASK_AGENT_MAX_ATTEMPTS=2
# TASK_AGENT_RETRY_MINUTES=15

# Папка состояния агента, заданий и журналов запусков.
# TASK_AGENT_STATE_DIR=.task-agent

# Снимки (npm run shot): адрес запущенного dev-сервера игры и браузер (chrome — установленный Google Chrome).
# TASK_AGENT_GAME_URL=http://localhost:4800
# TASK_AGENT_BROWSER_CHANNEL=
